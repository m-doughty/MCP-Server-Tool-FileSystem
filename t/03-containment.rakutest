use Test;
use lib 'lib';
use MCP::Server::Tool::FileSystem::Test::Kit;
use MCP::Server;
use MCP::Server::Tool::FileSystem;

plan 11;

my $sandbox = make-sandbox('containment');
my $outside = make-sandbox('outside');
END {
	nuke($sandbox);
	nuke($outside);
}

$sandbox.add('dir').mkdir;
$sandbox.add('dir').add('inner.txt').spurt('inner');
$sandbox.add('ok.txt').spurt('fine');
$outside.add('secret.txt').spurt('SECRET');
$outside.add('vault').mkdir;
$outside.add('vault').add('key.txt').spurt('KEY');

my $server = MCP::Server.new(:name<confined>);
$server.plug: MCP::Server::Tool::FileSystem.new(:root($sandbox));

#| Run &code on a thread of its own and give it $seconds: the Promise comes
#| back kept only if the code finished in time. A walk that never ended would
#| otherwise take the whole file with it.
sub in-time(&code, Real:D $seconds = 10 --> Promise:D) {
	my $work = start { code() };
	await Promise.anyof($work, Promise.in($seconds));
	$work;
}

subtest 'Paths that could leave the root are refused' => {
	my @cases =
		'../x'                => "may not contain '..'",
		'a/../../x'           => "may not contain '..'",
		# Strict on purpose: '..' is refused even when the result would have
		# stayed inside the root, so there is one rule to reason about.
		'dir/../ok.txt'       => "may not contain '..'",
		'..\\..\\x'           => "may not contain '..'",
		'/etc/passwd'         => 'must be relative to the configured root',
		'C:\\Windows'         => 'must be relative to the configured root',
		'\\\\server\\share'   => 'must be relative to the configured root',
		'/'                   => 'must be relative to the configured root',
		''                    => 'must not be empty',
		"ok\0.txt"            => 'must not contain a null byte',
		'NUL'                 => 'reserved device name',
		'nul.txt'             => 'reserved device name',
		'dir/COM1'            => 'reserved device name',
		# Windows compares a device name before the first dot, trailing
		# spaces dropped, and COM/LPT take 0 and the superscripts too.
		'NUL .txt'            => 'reserved device name',
		'COM0'                => 'reserved device name',
		'dir/lpt¹.log'        => 'reserved device name',
		'CONIN$'              => 'reserved device name',
	;
	plan @cases.elems;
	for @cases -> (:key($path), :value($needle)) {
		errors-with $server, 'fs_read', { path => $path }, $needle,
			"read '{$path.subst("\0", '\\0', :g)}' is refused";
	}
};

subtest 'Legitimate relative paths are accepted' => {
	plan 5;
	is result-text(call-tool($server, 'fs_read', { path => 'ok.txt' })), 'fine',
		'Plain relative path';
	is result-text(call-tool($server, 'fs_read', { path => './ok.txt' })), 'fine',
		'Leading ./ is harmless';
	is result-text(call-tool($server, 'fs_read', { path => 'dir//inner.txt' })), 'inner',
		'Repeated separators collapse';
	is result-text(call-tool($server, 'fs_read', { path => 'dir\\inner.txt' })), 'inner',
		'Backslash is accepted as a separator on every platform';
	is result-text(call-tool($server, 'fs_stat', { path => '.' })).lines.first(*.starts-with('path')),
		'path: .', 'The root itself is addressable as .';
};

subtest 'Every tool routes through the resolver' => {
	plan 12;
	errors-with $server, 'fs_read',  { path => '../ok.txt' },
		"may not contain '..'", 'read';
	errors-with $server, 'fs_list',  { path => '..' },
		"may not contain '..'", 'list';
	errors-with $server, 'fs_glob',  { pattern => '*', path => '..' },
		"may not contain '..'", 'glob';
	errors-with $server, 'fs_stat',  { path => '/etc' },
		'must be relative to the configured root', 'stat';
	errors-with $server, 'fs_grep',  { pattern => 'x', path => '..' },
		"may not contain '..'", 'grep';
	errors-with $server, 'fs_map',   { path => '..' },
		"may not contain '..'", 'map';
	errors-with $server, 'fs_write', { path => '../escape.txt', content => 'x' },
		"may not contain '..'", 'write';
	errors-with $server, 'fs_mkdir', { path => '../boom' },
		"may not contain '..'", 'mkdir';
	errors-with $server, 'fs_edit',
		{ path => '../ok.txt', 'old-string' => 'fine', 'new-string' => 'ruined' },
		"may not contain '..'", 'edit';
	# move has two path parameters, and either one on its own must be enough
	# to stop the call.
	errors-with $server, 'fs_move', { from => '../ok.txt', to => 'landed.txt' },
		"may not contain '..'", 'move (from)';
	errors-with $server, 'fs_move', { from => 'ok.txt', to => '../landed.txt' },
		"may not contain '..'", 'move (to)';
	errors-with $server, 'fs_delete', { path => '../ok.txt' },
		"may not contain '..'", 'delete';
};

subtest 'Refused writes leave nothing behind' => {
	plan 7;
	my $file  = $sandbox.parent.add("mcp-fs-escape-{$*PID}.txt");
	my $dir   = $sandbox.parent.add("mcp-fs-boom-{$*PID}");
	my $moved = $sandbox.parent.add("mcp-fs-moved-{$*PID}.txt");
	errors-with $server, 'fs_write', { path => "../{$file.basename}", content => 'x' },
		"may not contain '..'", 'Escaping write refused';
	errors-with $server, 'fs_mkdir', { path => "../{$dir.basename}" },
		"may not contain '..'", 'Escaping mkdir refused';
	errors-with $server, 'fs_move', { from => 'ok.txt', to => "../{$moved.basename}" },
		"may not contain '..'", 'Escaping move refused';
	nok $file.e, 'No file created outside the root';
	nok $dir.e, 'No directory created outside the root';
	nok $moved.e, 'Nothing moved outside the root';
	ok $sandbox.add('ok.txt').e, 'And the file the move named is still where it was';
};

subtest 'path-contains walks the parent chain' => {
	plan 6;
	my &contains = &MCP::Server::Tool::FileSystem::path-contains;
	ok contains($sandbox, $sandbox), 'The root contains itself';
	ok contains($sandbox, $sandbox.add('dir').add('inner.txt')), 'A descendant is contained';
	nok contains($sandbox, $sandbox.parent), 'An ancestor is not contained';
	nok contains($sandbox, $outside), 'An unrelated directory is not contained';

	# The string-prefix bug this exists to avoid: /tmp/root2 is not in /tmp/root.
	my $sibling = $sandbox.parent.add($sandbox.basename ~ '2');
	nok contains($sandbox, $sibling), 'A sibling sharing the root as a string prefix is not contained';
	ok contains($sibling, $sibling.add('child')), 'That sibling contains its own children';
};

subtest 'Symlinks pointing out of the root are refused' => {
	plan 8;
	my $file-link = $sandbox.add('escape.txt');
	my $dir-link  = $sandbox.add('escape-dir');
	# Symlink creation can legitimately fail (an unprivileged Windows host, a
	# filesystem without link support), and sinking the Failure it returns would
	# throw — hence the try. The reads below must fail either way, so the
	# assertions adapt rather than skip.
	try $outside.add('secret.txt').symlink($file-link);
	try $outside.add('vault').symlink($dir-link);

	my $file-needle = $file-link.l ?? 'escapes the configured root' !! 'not found';
	errors-with $server, 'fs_read', { path => 'escape.txt' }, $file-needle,
		'Reading through a symlinked file is refused';

	my $dir-needle = $dir-link.l ?? 'escapes the configured root' !! 'not found';
	errors-with $server, 'fs_read', { path => 'escape-dir/key.txt' }, $dir-needle,
		'Reading through a symlinked directory is refused';
	errors-with $server, 'fs_list', { path => 'escape-dir' }, $dir-needle,
		'Listing a symlinked directory is refused';
	errors-with $server, 'fs_write', { path => 'escape.txt', content => 'x' }, $file-needle,
		'Writing through a symlinked file is refused';
	errors-with $server, 'fs_edit',
		{ path => 'escape.txt', 'old-string' => 'SECRET', 'new-string' => 'x' }, $file-needle,
		'Editing through a symlinked file is refused';
	errors-with $server, 'fs_grep', { pattern => 'KEY', path => 'escape-dir' }, $dir-needle,
		'Searching a symlinked directory is refused';

	# A search of the root must not do by accident what naming the link does
	# not do on purpose: the walk never descends a symlinked directory, and a
	# symlinked file whose target is outside the root is never opened.
	my $swept = result-text(call-tool($server, 'fs_grep', { pattern => 'KEY', path => '.' }));
	nok $swept.contains('key.txt'), 'A search of the whole root never reaches through the directory link';
	nok result-text(call-tool($server, 'fs_grep', { pattern => 'SECRET', path => '.' })).contains('escape.txt'),
		'Nor through the file link';
};

subtest 'Symlinks staying inside the root still work' => {
	plan 2;
	my $link = $sandbox.add('inside.txt');
	try $sandbox.add('dir').add('inner.txt').symlink($link);
	my %response = call-tool($server, 'fs_read', { path => 'inside.txt' });
	if $link.l {
		nok result-errored(%response), 'An in-root symlink is not treated as an escape';
		is result-text(%response), 'inner', 'Its target reads back';
	} else {
		# No symlink support: the tool must still fail cleanly rather than lie.
		ok result-errored(%response), 'Without symlink support the read fails cleanly';
		ok result-text(%response).contains('not found'), 'And says the file is missing';
	}
};

subtest 'Symlink chains, relative targets and cycles' => {
	plan 6;

	# Same adapt-don't-skip convention as above: when links cannot be made,
	# every read fails as plain not-found and the assertions follow suit.
	#
	# Absolute-target links go through IO::Path.symlink.  The RELATIVE ones
	# go through `ln -s`, because Rakudo's .symlink absolutifies a relative
	# invocant against the CWD before writing the link — there is no way to
	# create a genuinely relative symlink from the core API.  On a host
	# whose `ln` copies instead of linking (Git for Windows without MSYS
	# winsymlinks), the copy still reads back 'fine', which the assertions
	# below accept: the point here is the chase, not `ln`.
	try $outside.add('secret.txt').symlink($sandbox.add('hop-out.txt'));
	try $sandbox.add('hop-out.txt').symlink($sandbox.add('hop-in.txt'));
	try $outside.symlink($sandbox.add('sneak'));                   # dir link out, used mid-path
	try $sandbox.add('loop-b').symlink($sandbox.add('loop-a'));
	try $sandbox.add('loop-a').symlink($sandbox.add('loop-b'));
	my $ = try run 'ln', '-s', 'ok.txt', 'alias.txt',
		:cwd($sandbox), :out(False), :err(False);
	my $ = try run 'ln', '-s', '../ok.txt', 'updown.txt',
		:cwd($sandbox.add('dir')), :out(False), :err(False);

	my $chain = $sandbox.add('hop-in.txt');
	errors-with $server, 'fs_read', { path => 'hop-in.txt' },
		($chain.l ?? 'escapes the configured root' !! 'not found'),
		'A chain of links ending outside the root is refused';

	errors-with $server, 'fs_read', { path => 'sneak/secret.txt' },
		($sandbox.add('sneak').l ?? 'escapes the configured root' !! 'not found'),
		'A directory link out of the root is refused mid-path';

	errors-with $server, 'fs_read', { path => 'loop-a' },
		($sandbox.add('loop-a').l ?? 'probable cycle' !! 'not found'),
		'A symlink cycle is refused rather than looped';

	my $alias = $sandbox.add('alias.txt');
	my %alias = call-tool($server, 'fs_read', { path => 'alias.txt' });
	ok ($alias.e ?? (!result-errored(%alias) && result-text(%alias) eq 'fine')
	             !! result-errored(%alias)),
		'A relative in-root link reads through';

	my $updown = $sandbox.add('dir').add('updown.txt');
	my %updown = call-tool($server, 'fs_read', { path => 'dir/updown.txt' });
	ok ($updown.e ?? (!result-errored(%updown) && result-text(%updown) eq 'fine')
	              !! result-errored(%updown)),
		"A relative link using '..' that stays inside the root reads through";

	# The chase itself, without the tool layer: the physical destination of
	# the in-root alias is inside the root, the escaping chain's is not.
	# Only meaningful when the links are real; vacuously true otherwise,
	# matching the subtest's adapt convention.
	my &physical = &MCP::Server::Tool::FileSystem::physical-path;
	my &contains = &MCP::Server::Tool::FileSystem::path-contains;
	ok (($alias.l && $chain.l)
		?? (contains($sandbox, physical($alias)) && !contains($sandbox, physical($chain)))
		!! True),
		'physical-path chases to the true destination';
};

# A client's permission rules judge the name a call spells, so the name the
# OS opens must be that one. On Windows a ':' (a data stream -- the
# j::$INDEX_ALLOCATION form reaches through a junction j), a trailing dot or
# space (dropped) and an 8.3 short name (opened as whichever long name it was
# given) all open some other name, and are refused. The rule is pure string
# work, so it is pinned on every host.
#
# What a stand-in $*DISTRO can and cannot make of a host. It decides which
# rules the resolver applies -- whether a segment is checked for these names,
# whether '\' separates, whether a drive letter is a volume -- and nothing
# else: the paths themselves still come from IO::Path, spelled the way the
# host's own $*SPEC spells them. A Windows stand-in on POSIX is therefore a
# faithful Windows, because the Windows rules read '/'-spelled paths as well
# as '\'-spelled ones; it runs on every host. A POSIX stand-in on Windows is
# not a POSIX host at all: the root comes back as D:\a\...\root, the POSIX
# rules split it on '/' alone, and the resolver -- correctly, for the paths it
# was handed -- cannot see the file inside the root it is. So the POSIX half
# is asserted with the host's own $*DISTRO and no stand-in: on POSIX, that
# these names are ordinary; on Windows, that the real platform refuses them.
subtest 'On Windows, a segment Windows would read as another name is refused' => {
	my &hazard = &MCP::Server::Tool::FileSystem::windows-segment-hazard;
	my @refused = 'j::$INDEX_ALLOCATION', 'x:stream', 'secret.', 'secret ', '...', '. .',
		'SECRET~1', 'secret~1', 'PROGRA~1.TXT', 'SECRE~A1', '~$DOCU~1.DOC';
	my @fine = 'secret', 'notes~2024.md', 'foo.txt.~1~', 'report~1.html', 'backup~', '~',
		'ABCDEFGHI~1', 'a.b.c', '.hidden';
	plan @refused + @fine + 9;

	ok hazard($_).defined, "'$_' is refused" for @refused;
	nok hazard($_).defined, "'$_' is a plain name" for @fine;

	{
		my $*DISTRO = class { method is-win(--> Bool) { True } }.new;
		errors-with $server, 'fs_read', { path => 'link::$INDEX_ALLOCATION\\secret.txt' },
			'data stream', 'a stream of a directory is refused';
		errors-with $server, 'fs_read', { path => 'dir\\j::$INDEX_ALLOCATION\\secret.txt' },
			'data stream', 'at any depth';
		errors-with $server, 'fs_read', { path => 'dir\\INNER~1.TXT' },
			'8.3 short name', 'an 8.3 short name is refused';
		errors-with $server, 'fs_read', { path => 'ok.txt.' }, 'dot or a space',
			'a trailing dot is refused';
		errors-with $server, 'fs_write', { path => 'dir/x ', content => 'no' }, 'dot or a space',
			'a trailing space is refused, for a write too';
		nok $sandbox.add('dir').add('x ').e, 'and nothing was written';
		is result-text(call-tool($server, 'fs_read', { path => 'dir\\inner.txt' })), 'inner',
			'an ordinary path is still served';
	}

	# With the host's own $*DISTRO, no stand-in.
	if $*DISTRO.is-win {
		errors-with $server, 'fs_read', { path => 'missing.' }, 'dot or a space',
			'on this Windows host, with its own $*DISTRO, a trailing dot is refused';
		errors-with $server, 'fs_read', { path => 'MISSIN~1' }, '8.3 short name',
			'and so is an 8.3 short name';
	} else {
		# On POSIX every one of those is an ordinary name: a read of one that
		# does not exist is "not found", never refused.
		errors-with $server, 'fs_read', { path => 'missing.' }, 'not found',
			'a trailing dot is a name on POSIX';
		errors-with $server, 'fs_read', { path => 'MISSIN~1' }, 'not found',
			'and so is a tilde';
	}
};

# Every walk up a path's parents has to end, because a client controls the
# path strings and a walk that does not end is a server that has stopped
# answering. Each call below runs on a thread of its own under a deadline, so
# a walk that never ends fails its assertion instead of taking the file with
# it.
#
# What is real and what is emulated. The spellings are real input, sent
# through the real tools with the host's own rules: backslashes, drive and
# UNC prefixes, device paths, mixed separators, trailing dots and spaces, runs
# of thousands of separators. None of them hung on any build of this pack;
# they are here so none ever does. The walk that DID never end needs a path
# that is not absolute, whose parents go on for ever (the parent of '..' is
# '../..'), and only one platform's rules applied to another's spelling make
# one: a Windows stand-in for $*DISTRO on POSIX, meeting a link to C:\x, read
# that as a path on drive C: and handed the walk the relative POSIX path
# 'C:/x'. That is emulated, so it runs on POSIX, the only place it can arise;
# the walk's own refusal of a relative path is pinned on every host.
subtest 'No spelling of a path makes a containment walk go on for ever' => {
	my Bool:D $posix = !$*DISTRO.is-win;
	# Q[...] throughout, so that every backslash is one backslash.
	my @spellings =
		Q[a\b], Q[dir\inner.txt], Q[C:\x\y], 'C:/x', 'C:x', 'C:', 'Z:/dir',
		Q[\\server\share\x], '//server/share/x', Q[\\?\C:\x], Q[\\.\pipe\x], '//?/C:/x', '//./pipe/x',
		Q[\], Q[\\], Q[\\?\], '//', Q[a/b\c/d], Q[dir\.\inner.txt], Q[dir\..\ok.txt], Q[..\x],
		'x.', 'x ', 'x. ', 'dir. ', Q[dir\inner.txt.], '. .',
		'dir' ~ (Q[\] x 5000) ~ 'inner.txt', 'a' ~ (Q[\] x 10000), Q[a\] x 3000,
		'dir' ~ ('/' x 5000) ~ 'inner.txt', 'x' x 5000, Q[dir\CON\x], 'x:stream', 'MISSIN~1';
	my @tools = <fs_stat fs_read fs_grep>;
	plan 3 + $posix;

	# A pack of its own: a read holds its instance's lock, and a walk that
	# never ended would hold it for good, wedging every later subtest's call
	# instead of failing only this one.
	my $hostile = MCP::Server.new(:name<hostile>);
	$hostile.plug: MCP::Server::Tool::FileSystem.new(:root($sandbox));

	my &contains = &MCP::Server::Tool::FileSystem::path-contains;
	my $relative = in-time({ contains($sandbox, 'a/b'.IO) });
	ok $relative.status ~~ Kept && !$relative.result,
		'A relative path is not inside the root, and the walk says so at once';
	my $dot-dot = in-time({ contains($sandbox, '..'.IO) });
	ok $dot-dot.status ~~ Kept && !$dot-dot.result, "and so is '..', whose parents never end";

	my @late;
	for @spellings X @tools -> ($spelling, $tool) {
		my %args = $tool eq 'fs_grep'
			?? %( pattern => 'inner', path => $spelling )
			!! %( path => $spelling );
		my $call = in-time({ call-tool($hostile, $tool, %args) });
		@late.push: "$tool {$spelling.raku.substr(0, 40)}" unless $call.status ~~ Kept;
	}
	ok !@late, "Every one of {@spellings * @tools} calls with a hostile spelling answered in time";
	diag "no answer in time: $_" for @late;

	if $posix {
		my $link = $sandbox.add('drive-link');
		run('ln', '-s', 'C:\x\y', $link.absolute, :out, :err).out.slurp(:close);
		LEAVE { $link.unlink if $link.l }
		my class WindowsStandIn { method is-win(--> Bool) { True } }
		my $read = do {
			my $*DISTRO = WindowsStandIn.new;
			in-time({ result-text(call-tool($hostile, 'fs_read', { path => 'drive-link' })) });
		};
		ok $read.status ~~ Kept && $read.result.contains('escapes the configured root'),
			'A Windows stand-in meeting a link to C:\x\y refuses it rather than climbing for ever';
	}
};

subtest 'A recursive delete unlinks symlinks instead of following them' => {
	plan 4;
	my $doomed = $sandbox.add('doomed');
	$doomed.mkdir;
	$doomed.add('own.txt').spurt('mine');
	my $link = $doomed.add('link-out');
	try $outside.add('vault').symlink($link);

	my %response = call-tool($server, 'fs_delete', { path => 'doomed', recursive => True });
	nok result-errored(%response), 'The recursive delete succeeds';
	is result-text(%response), "Deleted directory 'doomed' and everything below it",
		'And says what it took';
	nok $doomed.e, 'The directory and its own contents are gone';
	# True either way on a host without symlinks, where nothing was planted:
	# the point is that the delete never reached outside the root.
	ok $outside.add('vault').add('key.txt').e, 'What the link pointed at outside the root survives';
};

done-testing;
